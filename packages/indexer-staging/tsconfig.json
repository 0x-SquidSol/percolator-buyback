{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@percolatorct/sdk": ["../sdk-staging/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "tests"]
}
